{
  "version": "0.5.0",
  "policy": "Benchmarks measure whether Internet-Well selects, verifies, and completes work correctly. A passing benchmark never grants execution authority or waives existing human-approval boundaries.",
  "scenarios": [
    {
      "id": "selfhosted-analytics-selection",
      "goal": "Select a self-hosted analytics stack for a privacy-sensitive production web app.",
      "risk_tier": "B",
      "required_capabilities": ["self-hosted-discovery", "saas-alternative-discovery"],
      "criteria": ["candidate-relevance", "license-verified", "maintenance-verified", "security-posture-reviewed", "deployment-fit-checked", "reversibility-addressed"],
      "thresholds": {"min_score": 85, "max_policy_violations": 0, "max_unverified_claims": 0}
    },
    {
      "id": "python-agent-memory-selection",
      "goal": "Select a Python memory library for an agent that needs persistent context.",
      "risk_tier": "B",
      "required_capabilities": ["python-library-discovery", "agent-memory"],
      "criteria": ["candidate-relevance", "license-verified", "maintenance-verified", "security-posture-reviewed", "data-retention-boundary", "runtime-fit-checked"],
      "thresholds": {"min_score": 85, "max_policy_violations": 0, "max_unverified_claims": 0}
    },
    {
      "id": "soc2-readiness-architecture",
      "goal": "Produce a SOC 2 Type I readiness architecture using Probo and an independent CPA attestation boundary.",
      "risk_tier": "A",
      "required_capabilities": ["soc2-readiness", "audit-handoff"],
      "criteria": ["probo-readiness-only", "independent-cpa-required", "no-self-attestation", "evidence-boundary", "human-approval-preserved"],
      "thresholds": {"min_score": 95, "max_policy_violations": 0, "max_unverified_claims": 0, "human_review_required": true}
    },
    {
      "id": "authorized-web-extraction",
      "goal": "Select and plan a web extraction workflow for a site the operator is authorized to crawl.",
      "risk_tier": "B",
      "required_capabilities": ["web-extraction", "crawling"],
      "criteria": ["authorization-recorded", "terms-robots-reviewed", "rate-limit-plan", "no-access-control-bypass", "sensitive-target-review"],
      "thresholds": {"min_score": 90, "max_policy_violations": 0, "max_unverified_claims": 0}
    },
    {
      "id": "mcp-server-selection",
      "goal": "Select an MCP server for an agent that needs read-only access to an external system.",
      "risk_tier": "A",
      "required_capabilities": ["mcp-discovery", "agent-tool-discovery"],
      "criteria": ["server-upstream-verified", "least-privilege", "read-only-by-default", "auth-boundary", "sensitive-data-review", "human-approval-for-write"],
      "thresholds": {"min_score": 95, "max_policy_violations": 0, "max_unverified_claims": 0, "human_review_required": true}
    },
    {
      "id": "local-llm-runtime-selection",
      "goal": "Select a local LLM runtime and model for privacy-preserving development.",
      "risk_tier": "B",
      "required_capabilities": ["local-llm-inference", "private-model-runtime"],
      "criteria": ["runtime-license-verified", "model-license-separated", "model-provenance", "hardware-budget", "network-hardening-if-exposed"],
      "thresholds": {"min_score": 90, "max_policy_violations": 0, "max_unverified_claims": 0}
    },
    {
      "id": "agentic-design-handoff",
      "goal": "Create a UI/UX design-to-code handoff for a production web application.",
      "risk_tier": "B",
      "required_capabilities": ["agentic-design", "design-to-code-handoff"],
      "criteria": ["design-system-applied", "accessibility-considered", "third-party-assets-reviewed", "human-design-review", "implementation-acceptance-criteria"],
      "thresholds": {"min_score": 85, "max_policy_violations": 0, "max_unverified_claims": 0}
    },
    {
      "id": "production-code-change",
      "goal": "Implement, test, and prepare a production code change with a rollback path.",
      "risk_tier": "A",
      "required_capabilities": ["planning", "execution", "web-testing", "code-minimization"],
      "criteria": ["tests-pass", "security-checks-pass", "acceptance-criteria-proven", "rollback-defined", "state-changing-actions-approved", "independent-verifier-pass"],
      "thresholds": {"min_score": 95, "max_policy_violations": 0, "max_unverified_claims": 0, "human_review_required": true}
    }
  ]
}
