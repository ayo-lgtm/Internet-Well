{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "policy": "Adapters may inspect and plan without approval. Installation, browser control, remote provider use, or repository modification requires explicit approval and a pinned source where applicable.",
  "integrations": [
    {
      "id": "anthropic-skills",
      "name": "Anthropic Agent Skills",
      "catalog_slug": "anthropics/skills",
      "kind": "skill-library",
      "source": "https://github.com/anthropics/skills",
      "install_mode": "selective-copy",
      "pin_required": true,
      "license_review": "per-skill",
      "targets": ["claude-code", "codex", "cursor", "generic-agent"],
      "capabilities": ["skill-authoring", "document-workflows", "mcp-generation"],
      "approval_required": true,
      "default_action": "inspect",
      "notes": "Copy only selected, reviewed skill directories. Do not vendor the full repository by default."
    },
    {
      "id": "skills-cli",
      "name": "Skills CLI and skills.sh",
      "catalog_slug": "vercel-labs/skills",
      "kind": "skill-installer",
      "source": "https://github.com/vercel-labs/skills",
      "install_mode": "npx",
      "command_template": ["npx", "skills", "add", "{source}@{ref}"],
      "pin_required": true,
      "license_review": "required",
      "targets": ["claude-code", "codex", "cursor", "generic-agent"],
      "capabilities": ["skill-discovery", "skill-installation"],
      "approval_required": true,
      "default_action": "plan",
      "notes": "Marketplace discovery is not verification. Inspect the selected skill before installation."
    },
    {
      "id": "agent-browser",
      "name": "Vercel Agent Browser",
      "catalog_slug": "vercel-labs/agent-browser",
      "kind": "browser-runtime",
      "source": "https://github.com/vercel-labs/agent-browser",
      "install_mode": "npx",
      "command_template": ["npx", "agent-browser@{ref}", "--help"],
      "pin_required": true,
      "license_review": "required",
      "targets": ["local-cli", "agent-runtime"],
      "capabilities": ["browser-automation", "accessibility-tree", "web-testing"],
      "approval_required": true,
      "containment_profile": "browser-high-risk",
      "default_action": "plan",
      "notes": "Authenticated sessions, form submission, downloads, publishing, purchases, and account changes require separate action approval."
    },
    {
      "id": "gsd",
      "name": "Get Shit Done",
      "catalog_slug": "gsd-build/get-shit-done",
      "kind": "workflow-system",
      "source": "https://github.com/gsd-build/get-shit-done",
      "install_mode": "git-reference",
      "pin_required": true,
      "license_review": "required",
      "targets": ["claude-code", "generic-agent"],
      "capabilities": ["spec-driven-development", "context-engineering", "planning"],
      "approval_required": true,
      "default_action": "inspect",
      "forbidden_flags": ["--dangerously-skip-permissions"],
      "notes": "Internet-Well permission and evidence rules override upstream workflow instructions."
    },
    {
      "id": "taste-skill",
      "name": "Taste Skill",
      "catalog_slug": "Leonxlnx/taste-skill",
      "kind": "skill-library",
      "source": "https://github.com/Leonxlnx/taste-skill",
      "install_mode": "selective-copy",
      "pin_required": true,
      "license_review": "required",
      "targets": ["claude-code", "codex", "cursor", "generic-agent"],
      "capabilities": ["frontend-design", "image-to-code", "design-systems"],
      "approval_required": true,
      "default_action": "inspect",
      "quality_gates": ["accessibility", "reduced-motion", "performance", "brand-preservation"],
      "notes": "Experimental design assistance; not proof of good design."
    },
    {
      "id": "humanizer",
      "name": "Humanizer",
      "catalog_slug": "blader/humanizer",
      "kind": "writing-skill",
      "source": "https://github.com/blader/humanizer",
      "install_mode": "selective-copy",
      "pin_required": true,
      "license_review": "required",
      "targets": ["claude-code", "codex", "cursor", "generic-agent"],
      "capabilities": ["editorial-review", "voice-calibration"],
      "approval_required": true,
      "default_action": "inspect",
      "prohibited_uses": ["authorship-deception", "fabricated-experience", "plagiarism-concealment"],
      "notes": "Professional and legal writing remains subject to human responsibility and review."
    },
    {
      "id": "storyscope",
      "name": "Storyscope",
      "catalog_slug": "jenna-russell/storyscope",
      "kind": "reference-implementation",
      "source": "https://github.com/jenna-russell/storyscope",
      "install_mode": "git-reference",
      "pin_required": true,
      "license_review": "blocking-until-confirmed",
      "targets": ["product-research"],
      "capabilities": ["product-storytelling", "narrative-context"],
      "approval_required": true,
      "default_action": "inspect",
      "notes": "No code adoption until repository identity and license are confirmed."
    },
    {
      "id": "react-bits",
      "name": "React Bits",
      "catalog_slug": "DavidHDev/react-bits",
      "kind": "component-reference",
      "source": "https://github.com/DavidHDev/react-bits",
      "install_mode": "selective-copy",
      "pin_required": true,
      "license_review": "commons-clause-review",
      "targets": ["react", "nextjs"],
      "capabilities": ["react-components", "animation", "interactive-ui"],
      "approval_required": true,
      "default_action": "inspect",
      "quality_gates": ["keyboard", "screen-reader", "reduced-motion", "bundle-size", "gpu-cost"],
      "notes": "Adopt individual components only after license and quality review."
    },
    {
      "id": "animejs",
      "name": "Anime.js",
      "catalog_slug": "animejs/anime",
      "kind": "package",
      "source": "https://github.com/juliangarnier/anime",
      "install_mode": "npm",
      "command_template": ["npm", "install", "animejs@{ref}"],
      "pin_required": true,
      "license_review": "MIT",
      "targets": ["web", "react", "nextjs"],
      "capabilities": ["web-animation", "svg-animation", "timelines"],
      "approval_required": true,
      "default_action": "plan",
      "quality_gates": ["reduced-motion", "main-thread-performance", "low-end-device-test"],
      "notes": "Install only when a dedicated animation engine is justified."
    },
    {
      "id": "shader-gradient",
      "name": "Shader Gradient",
      "catalog_slug": "shadergradient/shadergradient",
      "kind": "hosted-provider",
      "source": "https://www.shadergradient.co",
      "install_mode": "provider",
      "pin_required": false,
      "license_review": "provider-terms-required",
      "targets": ["design-prototype"],
      "capabilities": ["animated-gradients", "webgl-backgrounds"],
      "approval_required": true,
      "provider_consent_required": true,
      "default_action": "provider-review",
      "quality_gates": ["static-fallback", "reduced-motion", "gpu-cost", "battery-impact"]
    },
    {
      "id": "jitter",
      "name": "Jitter",
      "catalog_slug": "jitter-video/jitter",
      "kind": "hosted-provider",
      "source": "https://jitter.video",
      "install_mode": "provider",
      "pin_required": false,
      "license_review": "provider-terms-required",
      "targets": ["motion-design"],
      "capabilities": ["motion-design", "video-export"],
      "approval_required": true,
      "provider_consent_required": true,
      "default_action": "provider-review",
      "notes": "Do not upload confidential assets without authorization and terms review."
    },
    {
      "id": "refero",
      "name": "Refero",
      "catalog_slug": "refero-design/refero",
      "kind": "hosted-provider",
      "source": "https://refero.design",
      "install_mode": "provider",
      "pin_required": false,
      "license_review": "provider-terms-required",
      "targets": ["design-research"],
      "capabilities": ["design-inspiration", "design-system-analysis"],
      "approval_required": true,
      "provider_consent_required": true,
      "default_action": "provider-review",
      "prohibited_uses": ["copy-protected-branding", "copy-distinctive-expression"],
      "notes": "Extract general design principles and record inspiration sources."
    },
    {
      "id": "10x-app-builder",
      "name": "10x App Builder",
      "catalog_slug": "10x-app-builder/10x",
      "kind": "hosted-provider",
      "source": "https://10x.dev",
      "install_mode": "provider",
      "pin_required": false,
      "license_review": "provider-terms-required",
      "targets": ["ios-prototype"],
      "capabilities": ["ios-generation", "app-store-assets"],
      "approval_required": true,
      "provider_consent_required": true,
      "default_action": "provider-review",
      "quality_gates": ["code-ownership", "exportability", "privacy", "security", "app-store-compliance", "deletion-rights"]
    }
  ]
}
