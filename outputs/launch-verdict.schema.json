{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://internet-well.local/schemas/launch-verdict.schema.json",
  "title": "Internet-Well Launch Verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "verdict", "critical_journeys", "gates", "blockers", "conditions", "evidence", "approvals", "rollback"],
  "properties": {
    "project": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["go", "conditional-go", "hold", "no-go", "insufficient-evidence"]},
    "critical_journeys": {"type": "array", "items": {"type": "object", "required": ["name", "status"], "properties": {"name": {"type": "string"}, "status": {"enum": ["pass", "fail", "blocked", "unverified"]}, "evidence": {"type": "array", "items": {"type": "string"}}}}},
    "gates": {"type": "object", "additionalProperties": {"enum": ["pass", "fail", "blocked", "unverified", "not-applicable"]}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "conditions": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "approvals": {"type": "array", "items": {"type": "string"}},
    "rollback": {"type": "array", "items": {"type": "string"}},
    "post_launch_monitoring": {"type": "array", "items": {"type": "string"}},
    "decision_date": {"type": "string", "format": "date"}
  }
}
